# OntoAxis (.gitignore)
#
# Ignore only local-only files and rebuildable artifacts. Never ignore source,
# docs, lockfiles, migrations, or generated code that CI drift-checks.
#
# Repo shape: Go service (cmd/, internal/) + buf/proto (proto/, gen/, openapi/)
# + React/Vite frontend (web/) + deploy/ (compose now; helm/argocd planned)
# + openspec/ governance.

# ---------------------------------------------------------------------------
# OS / editors / local tooling state
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Local environment and secrets (see .env.example / web/.env.example)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
.direnv/

# Real credential files; keep the *.example.yaml variants in Git.
*.secret.yaml
*.secret.yml
!*.secret.example.yaml
!*.secret.example.yml

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
/bin/
/dist/
/ontoaxis-core
*.exe
*.test
coverage.out
coverage.html
*.coverprofile
*.prof
*.pprof
*.trace
# vendor/ is intentionally not ignored: commit it if vendoring is adopted.

# ---------------------------------------------------------------------------
# Web frontend (React + Vite + pnpm, under web/)
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
web/dist/
web/.vite/
web/coverage/
test-results/
playwright-report/
blob-report/
.playwright/
*.tsbuildinfo
.eslintcache
.stylelintcache
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Local compose overrides and deploy leftovers
# ---------------------------------------------------------------------------
deploy/compose/compose.override.yaml
deploy/compose/compose.override.yml
deploy/**/charts/*.tgz

# ---------------------------------------------------------------------------
# Benchmarks, logs, temporary files (benchmarks/ planned in ARCHITECTURE.md)
# ---------------------------------------------------------------------------
benchmarks/results/*
!benchmarks/results/.gitkeep
tmp/
temp/
.cache/
*.log
!docs/stages/evidence/**/*.log
*.pid
*.seed
*.tmp
*.temp
*.orig
*.rej
*.bak

# ---------------------------------------------------------------------------
# Intentionally kept in Git (do not add ignore rules for these)
# ---------------------------------------------------------------------------
# - gen/                          buf-generated Go/Connect code
# - openapi/openapi.yaml          OpenAPI generated from proto
# - web/src/generated/            buf-generated TS types for the frontend
# - go.sum, web/pnpm-lock.yaml    lockfiles
# - internal/**/migrations/*.sql  goose migrations (embedded via go:embed)
# - openspec/, docs/, .github/workflows/
