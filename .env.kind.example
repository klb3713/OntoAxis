# OntoAxis local (kind) environment variables — KEYS ONLY, NO VALUES.
#
# Copy to `.env.kind` (git-ignored) and fill real values. Never commit `.env.kind`.
# scripts/delivery-secrets-bootstrap.sh maps these into the `ontoaxis-bootstrap`
# Secret; the ExternalSecrets reference it. Values are never printed by the scripts.
#
# Database: ONTOAXIS_DATABASE_URL is the full DSN (preferred). If unset,
# ONTOAXIS_DB_PASSWORD is used as the DSN string fallback by the bootstrap script.
ONTOAXIS_DATABASE_URL=
ONTOAXIS_DB_PASSWORD=

# OIDC / Keycloak
ONTOAXIS_OIDC_CLIENT_SECRET=
ONTOAXIS_KEYCLOAK_ADMIN_USER=
ONTOAXIS_KEYCLOAK_ADMIN_PASSWORD=
ONTOAXIS_KEYCLOAK_DB_PASSWORD=

# Search
ONTOAXIS_MEILISEARCH_MASTER_KEY=

# PostgreSQL
ONTOAXIS_POSTGRES_PASSWORD=

# Trino
ONTOAXIS_TRINO_USER=
ONTOAXIS_TRINO_PASSWORD=

# SeaweedFS / S3
ONTOAXIS_SEAWEEDFS_S3_ACCESS_KEY=
ONTOAXIS_SEAWEEDFS_S3_SECRET_KEY=

# OpenFGA
ONTOAXIS_OPENFGA_TOKEN=

# Backup
ONTOAXIS_BACKUP_PASSPHRASE=

# Composite credentials (optional if user/password provided)
ONTOAXIS_TRINO_CREDENTIALS=
ONTOAXIS_OPENFGA_DATASTORE_URI=
ONTOAXIS_POSTGRES_DB=ontoaxis
ONTOAXIS_POSTGRES_USER=ontoaxis
