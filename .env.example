ONTOAXIS_HTTP_ADDR=:8080
ONTOAXIS_METRICS_ADDR=:9090
ONTOAXIS_DATABASE_URL=postgres://ontoaxis:ontoaxis@localhost:15433/ontoaxis?sslmode=disable
ONTOAXIS_LOG_LEVEL=info
ONTOAXIS_SHUTDOWN_TIMEOUT=10s
ONTOAXIS_CORE_HOST_PORT=18080
ONTOAXIS_METRICS_HOST_PORT=19090
ONTOAXIS_POSTGRES_HOST_PORT=15433
ONTOAXIS_WEB_HOST_PORT=18082
ONTOAXIS_TRINO_HOST_PORT=18081
ONTOAXIS_ENVIRONMENT=local
ONTOAXIS_COMMIT=unknown
# Leave empty to disable trace export. Set to http://localhost:14318 when the
# observability profile is running on the host.
ONTOAXIS_OTEL_EXPORTER_OTLP_ENDPOINT=
ONTOAXIS_OTEL_SAMPLE_RATIO=1.0
ONTOAXIS_PROMETHEUS_HOST_PORT=19091
ONTOAXIS_ALERTMANAGER_HOST_PORT=19093
ONTOAXIS_JAEGER_HOST_PORT=16686
ONTOAXIS_PERSES_HOST_PORT=18084
ONTOAXIS_OTEL_GRPC_HOST_PORT=14317
ONTOAXIS_OTEL_HTTP_HOST_PORT=14318
ONTOAXIS_OTEL_METRICS_HOST_PORT=19464
ONTOAXIS_OTEL_INTERNAL_HOST_PORT=18888

# Stage 2 runtime configuration (non-secret; fill secrets via your secret store)
# Authorization (OpenFGA/Cedar). Local authz profile writes authz.env automatically.
ONTOAXIS_AUTHZ_OPENFGA_API_URL=http://openfga:8080
ONTOAXIS_AUTHZ_OPENFGA_STORE_ID=
ONTOAXIS_AUTHZ_OPENFGA_MODEL_ID=
ONTOAXIS_AUTHZ_OPENFGA_API_TOKEN=
ONTOAXIS_AUTHZ_POLICY_DIR=policies
ONTOAXIS_AUTHZ_AUDIT_SINK=stdout
# Object search (Meilisearch)
ONTOAXIS_SEARCH_ENABLED=false
ONTOAXIS_SEARCH_URL=http://meilisearch:7700
ONTOAXIS_SEARCH_API_KEY=
ONTOAXIS_SEARCH_INDEX_VERSION=v1
# Actions / Temporal
ONTOAXIS_ACTIONS_EXECUTION_MODE=noop
ONTOAXIS_TEMPORAL_HOST_PORT=
ONTOAXIS_ACTIONS_APPROVAL_TIMEOUT=30m
ONTOAXIS_ACTIONS_WORKFLOW_TIMEOUT=5m
ONTOAXIS_ACTIONS_WORKER_HTTP_ADDR=:18086
# Connector runtime / Kafka Connect (optional profile)
ONTOAXIS_CONNECT_URL=
ONTOAXIS_CONNECT_TIMEOUT=10s
ONTOAXIS_CONNECT_RETRY_MAX=5
ONTOAXIS_CONNECT_VERIFY_MAX_ROWS=1000000
# Pipelines / Kestra dbt (optional profile)
ONTOAXIS_KESTRA_URL=
ONTOAXIS_KESTRA_TIMEOUT=30s
ONTOAXIS_KESTRA_API_TOKEN=
ONTOAXIS_PIPELINE_DBT_CATALOG=memory
ONTOAXIS_PIPELINE_DBT_IMAGE=ontoaxis/dbt-trino:local
