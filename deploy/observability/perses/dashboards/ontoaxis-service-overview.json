{
  "kind": "Dashboard",
  "metadata": {
    "name": "ontoaxis-service-overview",
    "project": "ontoaxis"
  },
  "spec": {
    "display": {
      "name": "OntoAxis service overview",
      "description": "HTTP RED, readiness, database pool and SLO burn for ontoaxis-core."
    },
    "panels": {
      "requests": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP request rate"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "requests/sec"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "query": "sum(rate(ontoaxis_http_requests_total[5m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "5xx ratio"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "percent"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "query": "sum(rate(ontoaxis_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ontoaxis_http_requests_total[5m])), 1e-9)"
                  }
                }
              }
            }
          ]
        }
      },
      "latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "p95 latency"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "query": "histogram_quantile(0.95, sum by (le) (rate(ontoaxis_http_request_duration_seconds_bucket[5m])))"
                  }
                }
              }
            }
          ]
        }
      },
      "readiness": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Module readiness"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "query": "min(ontoaxis_module_ready)"
                  }
                }
              }
            }
          ]
        }
      },
      "dbpool": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Database pool"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "query": "sum(ontoaxis_db_pool_connections{state=\"acquired\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "availability": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Availability SLO (5m)"
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "query": "ontoaxis:slo_http_availability:ratio_5m"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "name": "Overview"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/requests"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/errors"
              }
            },
            {
              "x": 0,
              "y": 4,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/latency"
              }
            },
            {
              "x": 6,
              "y": 4,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/readiness"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/dbpool"
              }
            },
            {
              "x": 6,
              "y": 8,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/availability"
              }
            }
          ]
        }
      }
    ]
  }
}
