{
  "realm": "ontoaxis",
  "enabled": true,
  "displayName": "OntoAxis",
  "organizationsEnabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "platform-admin" },
      { "name": "tenant-admin" },
      { "name": "workspace-admin" },
      { "name": "member" },
      { "name": "viewer" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@ontoaxis.local",
      "firstName": "OntoAxis",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["platform-admin", "tenant-admin", "member"],
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ontoaxis-web",
      "name": "OntoAxis Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:18082/*",
        "http://127.0.0.1:18082/*"
      ],
      "webOrigins": [
        "http://localhost:18082",
        "http://127.0.0.1:18082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:18082/*"
      },
      "protocolMappers": [
        {
          "name": "ontoaxis-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ontoaxis-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "org_ids",
            "claim.value": "[\"11111111-1111-4111-8111-111111111111\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
