# oa-web 前端运行配置（Vite）
# 复制为 .env.local 后按需覆盖；不要提交任何 secret/token。

# API 模式：mock（本地合成 fixture）| http（调用 /api/v1 真实后端）
VITE_API_MODE=mock
# API 基地址，默认同源 /api/v1
VITE_API_BASE_URL=/api/v1

# 认证模式：mock（仅本地开发）| oidc（Keycloak / OIDC）
VITE_AUTH_MODE=mock

# OIDC / Keycloak（VITE_AUTH_MODE=oidc 时必填）
VITE_OIDC_AUTHORITY=https://keycloak.example.com/realms/ontoaxis
VITE_OIDC_CLIENT_ID=ontoaxis-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPES="openid profile email"
